# Lightning Network Development Environment
# Copy this file to .env.local for Lightning-enabled development
# 
# Usage: cp env.lightning.template .env.local

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_BAND_NAME=lnaddress music

# Environment
NODE_ENV=development

# Lightning Network Features (enabled)
NEXT_PUBLIC_ENABLE_LIGHTNING=true

# Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CDN URLs (optional for local development)
# NEXT_PUBLIC_CDN_URL=

# Optional: Custom Domain for Images
# NEXT_PUBLIC_IMAGE_DOMAIN=localhost:3000

# Database Configuration (optional for local development)
# POSTGRES_URL=postgresql://username:password@host:port/database
# POSTGRES_HOST=localhost
# POSTGRES_DATABASE=rss_music_site
# POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=password

# Podcast Index API Configuration (optional)
# PODCAST_INDEX_API_KEY=your-api-key
# PODCAST_INDEX_API_SECRET=your-api-secret

# Nostr Configuration (optional)
# NOSTR_RELAY_URLS=wss://relay.damus.io,wss://relay.snort.social
# NOSTR_PRIVATE_KEY=your-nostr-private-key

# Site Nostr key for boost notes (optional). Make a pair with: node scripts/generate-nostr-keys.js
# SITE_NOSTR_NSEC is SERVER-ONLY: the /api/nostr/boost-note route signs with it.
# Never name it NEXT_PUBLIC_...: Next.js copies NEXT_PUBLIC_ values into the browser bundle.
# On Vercel, add SITE_NOSTR_NSEC as a Sensitive variable.
# Without NEXT_PUBLIC_SITE_NOSTR_NPUB, each browser signs boost notes with its own random key.
# SITE_NOSTR_NSEC=nsec1...
# NEXT_PUBLIC_SITE_NOSTR_NPUB=npub1...

# Helipad Integration (optional - for testing)
# HELIPAD_WEBHOOK_SECRET=your-webhook-secret
# HELIPAD_AUTH_TOKEN=your-auth-token

# Breez SDK Spark Configuration (optional)
# Get a free API key at https://breez.technology/request-api-key/
# NEXT_PUBLIC_BREEZ_API_KEY=your-breez-api-key

# BoostBox Configuration (boost metadata storage)
# Defaults to https://tardbox.com if not set
# NEXT_PUBLIC_BOOSTBOX_URL=https://tardbox.com
NEXT_PUBLIC_BOOSTBOX_API_KEY=your-boostbox-api-key
